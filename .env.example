# LLM for extract, repro test and PR text (Pydantic AI model string)
LLM_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Coding agent (Claude Agent SDK)
CODER_MODEL=claude-opus-5-5

# decide(): mock | llm | jev
DECIDE_BACKEND=mock
JEV_API_KEY=

# Graph and merge gate
CONFIDENCE_THRESHOLD=0.85
MAX_RETRIES=2
MAX_DIFF_LINES=40
MAX_DIFF_FILES=3
SPOT_CHECK_RATE=0.05
MAX_AUTO_MERGES_PER_DAY=5
TRUST_MIN_CASES=30
TRUST_MIN_UNCHANGED=0.95

# GitHub (uses the gh CLI login)
GITHUB_REPO=abubakarwase/feedback-autopilot

# Optional
SLACK_WEBHOOK_URL=
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=

# Local testing
GITHUB_BASE_BRANCH=demo
DRY_RUN=0
CODER_BACKEND=agent   # agent | stub
