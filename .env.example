# Gemini API (Google AI Studio key). Pydantic AI reads GOOGLE_API_KEY.
GOOGLE_API_KEY=

# LLM for extract, repro test and PR text
LLM_MODEL=google:gemini-3.8-flash

# Coding agent: Pydantic AI agent with file tools in a git worktree
CODER_MODEL=google:gemini-3.1-pro-preview

# decide(): mock | llm | jev
DECIDE_BACKEND=mock
JEV_API_KEY=

# Graph and merge gate
CONFIDENCE_THRESHOLD=0.85
MAX_RETRIES=2
MAX_DIFF_LINES=40
MAX_DIFF_FILES=3
SPOT_CHECK_RATE=0.05
MAX_AUTO_MERGES_PER_DAY=5
TRUST_MIN_CASES=30
TRUST_MIN_UNCHANGED=0.95

# GitHub (mock = local git + SQLite; real uses the gh CLI login)
GITHUB_BACKEND=mock   # mock | real
GITHUB_REPO=abubakarwase/feedback-autopilot

# Optional
SLACK_WEBHOOK_URL=
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=

# Local testing
GITHUB_BASE_BRANCH=demo
DRY_RUN=0
CODER_BACKEND=gemini   # gemini | stub
